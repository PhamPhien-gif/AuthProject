# MẪU CẤU HÌNH LOCAL — copy thành .env khi chưa có file .env.
# Đặt cạnh AuthProject.sln (khuyến nghị) hoặc trong folder AuthProject/.
# Nếu cả hai nơi có .env, file trong project được ưu tiên; không merge hai file.
# Nếu đã có .env, bổ sung các key cần dùng vào file đó, giữ cấu hình riêng của bạn.
# Không commit .env; chỉ version file mẫu này. Xem Docs/05-LOCAL-DEVELOPMENT.md.
#
# API nạp .env trong Development: dotnet run --project AuthProject --launch-profile https
# EF CLI mặc định Development khi chưa đặt môi trường bên ngoài process.
# Production/Testing không nạp .env. Không đặt DOTNET_ENVIRONMENT trong file này
# để chọn môi trường; dùng launch profile hoặc biến môi trường của terminal/deployment.
# Environment variables và cấu hình command-line ưu tiên hơn .env.
# Sau khi sửa .env: restart API hoặc chạy lại lệnh EF.
#
# Format KEY=value; giá trị có spaces/# nên đặt trong single/double quotes.
# Không thực thi shell, không expand ${VAR}, không hỗ trợ multiline.

# SQL Server local: giữ MỘT backslash giữa tên máy và instance.
# Integrated Security dùng tài khoản Windows chạy lệnh/API.
# TrustServerCertificate=True dành cho cấu hình certificate local này.
ConnectionStrings__DefaultConnection='Server=LAPTOP-LTSU53RG\SQLEXPRESS01;Database=AuthProject;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;'

# EF database update không yêu cầu bật flag này.
# Đổi thành true khi API cần dùng DbContext/repositories; startup không tự migrate.
Persistence__Enabled=false

# Đường dẫn tương đối tính từ content root của API (thường là folder AuthProject/).
# Giữ directory keys bền vững để giải mã outbox; directory này được Git ignore.
Persistence__DataProtectionKeyDirectory='data-protection-keys'

# IdentityV3 password hashing: cho phép 210000–1000000 iterations.
Security__PasswordHash__IterationCount=210000

# Giới hạn request: body 1024–1048576 bytes; timeout 1–120 giây.
Api__MaxRequestBodyBytes=16384
Api__RequestTimeoutSeconds=15

# File sink log4net. P03 chưa có worker phát outbox; bật flag chưa tự phát event.
Audit__Log4Net__Enabled=false

# Các flow Auth chưa triển khai: giữ tắt, bổ sung cấu hình ở bước tương ứng.
# Bật module yêu cầu đủ options/credentials; không dùng secret demo.
Auth__Jwt__Enabled=false
Auth__Email__Enabled=false
Auth__Google__Enabled=false
Auth__EmailOtp__Enabled=false

# P04: rate limit theo process, luôn có quota API chung trước khi đọc body.
BruteForce__RateLimit__Enabled=true
BruteForce__RateLimit__MaxPartitions=10000
# Quota từng policy có mặc định trong BruteForceOptions; override khi cần đo/tune:
# BruteForce__RateLimit__Policies__Login__IpPermitLimit=10
# BruteForce__RateLimit__Policies__Login__IpWindowSeconds=60
# BruteForce__RateLimit__Policies__Login__AccountPermitLimit=30
# BruteForce__RateLimit__Policies__Login__WindowSeconds=900

# Counter SQL shared: 5 lần sai trong 15 phút -> khóa 15 phút, không gia hạn khi bị khóa.
BruteForce__Lockout__MaxFailedAttempts=5
BruteForce__Lockout__FailureWindowSeconds=900
BruteForce__Lockout__DurationSeconds=900

# Chỉ bật khi chạy sau reverse proxy mà bạn kiểm soát.
# Proxy phải gửi cả X-Forwarded-For và X-Forwarded-Proto, append/ghi đè header đúng cách.
TrustedProxy__Enabled=false
TrustedProxy__ForwardLimit=1
# Khi bật: thay IP/subnet bằng địa chỉ proxy thực tế; không dùng 0.0.0.0/0 hoặc ::/0.
# TrustedProxy__KnownProxies__0='10.0.0.1'
# TrustedProxy__KnownNetworks__0='10.0.0.0/24'

# Cập nhật schema sau khi .env có connection string và SQL Server đang hoạt động:
# dotnet tool restore
# dotnet ef database update --project AuthProject --startup-project AuthProject
