{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BruteForce": {
    "RateLimit": { "Enabled": true, "MaxPartitions": 10000 },
    "Lockout": { "MaxFailedAttempts": 5, "FailureWindowSeconds": 900, "DurationSeconds": 900 }
  },
  "TrustedProxy": { "Enabled": false, "ForwardLimit": 1, "KnownProxies": [], "KnownNetworks": [] },
  "Persistence": {
    "Enabled": false,
    "DataProtectionKeyDirectory": "data-protection-keys"
  },
  "Security": {
    "PasswordHash": { "IterationCount": 210000 }
  },
  "Audit": {
    "Log4Net": { "Enabled": false }
  },
  "Api": {
    "MaxRequestBodyBytes": 16384,
    "RequestTimeoutSeconds": 15
  },
  "Auth": {
    "Registration": { "Enabled": false },
    "Jwt": { "Enabled": false },
    "Email": { "Enabled": false },
    "Google": { "Enabled": false },
    "EmailOtp": { "Enabled": false }
  }
}
