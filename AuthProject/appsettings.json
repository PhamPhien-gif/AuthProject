{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "MaxRequestBodyBytes": 16384,
    "RequestTimeoutSeconds": 15
  },
  "Auth": {
    "Jwt": { "Enabled": false },
    "Email": { "Enabled": false },
    "Google": { "Enabled": false },
    "EmailOtp": { "Enabled": false }
  }
}
